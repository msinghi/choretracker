{
  "name": "family-chore-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless family chore tracker, point wallet, rewards redemption, and money trend graph backed by Google Sheets",
  "scripts": {
    "build": "vite build",
    "start": "vite build && node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.js",
    "server": "node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.js",
    "dev": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5"
  }
}
